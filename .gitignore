# =============================================================================
# Resume Craft — .gitignore
# Next.js 16 · React 19 · TypeScript · Tailwind CSS v4 · Vercel
# =============================================================================

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ──────────────────────────────────────────────────────
.next/
out/
build/

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Environment variables ─────────────────────────────────────────────────────
# Keep .env.example — commit templates, never secrets
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel

# ── Testing & coverage ────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Debug & log files ─────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ── OS-generated files ────────────────────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ── Editor & IDE ──────────────────────────────────────────────────────────────
# VS Code (keep shared settings if needed — untrack personal ones)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# Vim / Emacs swap files
*.swp
*.swo
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

# ── Certificates & secrets ────────────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx

# ── Miscellaneous ─────────────────────────────────────────────────────────────
*.tgz
*.zip
*.tar.gz
.cache/
.turbo/
